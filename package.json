{
  "name": "@focus-at/zs3",
  "version": "0.0.28",
  "description": "Zero-dependency micro S3 client built on Web Standards",
  "homepage": "https://github.com/focus-at/zs3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build --minify --sourcemap ./index.ts --outdir=dist",
    "patch": "npm version patch",
    "targs": "git push origin main --tags",
    "postinstall": "node -e \"if(!process.env.DISABLE_OPENCOLLECTIVE && !process.env.CI){process.stdout.write('\\u001b[35mThanks for installing ZeroS3! Consider giving it a star on GitHub: https://github.com\\u001b[0m\\n')}\""
  },
  "keywords": [
    "s3",
    "zs3",
    "zeros3",
    "zero",
    "aws",
    "amazon",
    "byos3",
    "whip",
    "client",
    "fetch",
    "crypto",
    "subtle",
    "stream",
    "edge",
    "workers",
    "cloudflare",
    "browser",
    "tiny",
    "micro",
    "mini",
    "light",
    "esm",
    "raw",
    "no dependencies",
    "tree shakable"
  ],
  "author": "Dmitry Zimin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:focus-at/zs3.git"
  },
  "bugs": {
    "url": "https://github.com/issues"
  },
  "funding": [
    {
      "type": "yoomoney",
      "url": "https://yoomoney.ru/to/41001733075084"
    }
  ],
  "files": [
    "dist",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
